  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FullyVolted.Feedback.ObjectivePanel
  procedureController: {fileID: 161175629}
  missionText: {fileID: 1188812242}
  stepCounterText: {fileID: 1718527215}
  titleText: {fileID: 1038254915}
  instructionText: {fileID: 1971598066}
  objectives:
  - title: Put on your helmet
    instruction: Pick up the HELMET from the bench.
  - title: Climb to the middle platform
    instruction: Use the ladder. Clip a carabiner onto an anchor and keep one clipped at all times.
  - title: Climb to the top of the tower
    instruction: Keep climbing and moving your carabiners up. Never let go unclipped.
  - title: Cut the power
    instruction: 'At the top, press the buttons in order: SWITCH OFF, TEST VOLTAGE, then GROUND AND LOCK.'
  - title: Climb down safely
    instruction: Power is off. Stay clipped in all the way back to the ground.
  missionLine: 'INSPECT THE TOWER: cut the power at the top'
  finished:
    title: Inspection complete
    instruction: Well done. Your results are saved.

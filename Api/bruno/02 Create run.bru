meta {
  name: Create run
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/runs
  body: json
  auth: none
}

headers {
  X-Api-Key: {{apiKey}}
}

body:json {
  {
    "trainee": "Bruno test"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  // Remember the new run's id so "Add step" and "Get run" use it.
  bru.setVar("runId", res.getBody().id);
}

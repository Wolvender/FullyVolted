# Copy to .env (gitignored) and fill in. The real values never get committed.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fullyvolted
DB_USER=fullyvolted_api
DB_PASSWORD=
# Unity and Bruno send this in the X-Api-Key header on every write.
API_KEY=
# Web portal addresses allowed to read the API (comma separated)
PORTAL_ORIGINS=http://localhost:5173
